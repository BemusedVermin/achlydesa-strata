---@meta
-- Generated by `strata stubs`. Describes the `ctx` argument every rule script receives.

---@class strata.Space
---@field q integer
---@field r integer
---@field z integer

---@class strata.Figure
---@field id integer
---@field unit integer
---@field controller integer
---@field status "reserve"|"on_board"|"destroyed"|"removed"
---@field location strata.Space|nil

---@class strata.UnitView
---@field id integer
---@field owner integer
---@field figures integer[]

--- Read-only views of the game. Assigning to any of them raises an error.
---@class strata.State
---@field round integer
---@field turn integer
---@field active integer The player whose turn it is.
---@field phases integer[] Active phases, outermost first.
---@field figures strata.Figure[]
---@field units strata.UnitView[]

---@class strata.Vars
---@field [string] any Reading gives the value; writing emits `VarSet`.

---@class strata.Ctx
---@field state strata.State
---@field query table<string, fun(...: any): any> `ctx.query.stat(figure, "defense")` runs a query with every modifier applied.
local Ctx = {}
--- Evaluates a selector. The result is an array sorted by ID.
---@param selector any
---@param subject? any
---@return integer[]
function Ctx.select(selector, subject) end
--- Per-instance variables for `owner`; every write becomes a `VarSet` event.
---@param owner string
---@return strata.Vars
function Ctx.vars(owner) end
--- Emits a custom event.
---@param kind string
---@param data? any
function Ctx.emit(kind, data) end
--- Writes to the rules trace. It has no effect on the game.
---@param ... any
function Ctx.log(...) end

--- Registrations a rule module makes from `register(r, cfg)`.
---@class strata.Registrar
---@field action fun(def: table)
---@field modifier fun(def: table)
---@field trigger fun(def: table)
---@field replacement fun(def: table)
---@field reaction fun(def: table)
---@field window fun(id: string)
