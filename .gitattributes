# Normalize all text to LF in the repo and in every checkout, on every OS.
* text=auto eol=lf

# Source and config (explicit, so detection never guesses wrong)
*.rs      text eol=lf
*.lua     text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.wgsl    text eol=lf
Cargo.lock text eol=lf

# Windows-only scripts keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets: never touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.ogg     binary
*.wav     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
*.woff2   binary
*.glb     binary
*.zip     binary
*.snap    text eol=lf